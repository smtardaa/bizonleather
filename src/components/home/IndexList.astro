---
import { url } from '../../lib/url';
import { Image } from 'astro:assets';
import { products, img, tl, productUrl, colorsOf, COLORS, coverImage } from '../../data/products';
const heroImg: Record<string, string> = {
  veyra: 'veyra-0',
  atlas: 'atlas-1',
  daren: 'daren-4',
  kora: 'kora-3',
  journals: 'journals-1',
  matara: 'matara-1',
};
---

<section class="idx" data-idx-root aria-labelledby="idx-title">
  <div class="wrap">
    <header class="idx-head">
      <p class="label">Koleksiyon · {String(products.length).padStart(2, '0')} parça</p>
      <h2 id="idx-title" class="display d-xl" data-reveal="lines">
        <span class="ln"><span>Altı parça.</span></span>
        <span class="ln"><span class="thread-text">Tek atölye.</span></span>
      </h2>
      <p class="idx-intro" data-reveal="fade">
        Her model hakiki sığır derisinden; kesimi, dikişi ve perdahı elde yapılır. Yeşil ve kahverengi iki tonda.
      </p>
    </header>

    <ol class="idx-list" role="list">
      {
        products.map((p, i) => (
          <li class="idx-item" data-idx-item={i}>
            <a class="idx-row" href={productUrl(p)}>
              <span class="idx-no mono">{String(i + 1).padStart(2, '0')}</span>
              <span class="idx-name display">{p.name}</span>
              <span class="idx-kind mono">{p.kind}</span>
              <span class="idx-sw swatches" aria-label={colorsOf(p).length ? `Renkler: ${colorsOf(p).map((c) => COLORS[c].label).join(', ')}` : 'Tek renk'}>
                {colorsOf(p).map((c) => (
                  <i style={`background:${COLORS[c].swatch}`} />
                ))}
              </span>
              <span class="price idx-price">
                <s>{tl(p.compareAt)}</s>
                {tl(p.price)}
              </span>
              <span class="idx-thumb" aria-hidden="true">
                <Image src={img(coverImage(p))} alt="" widths={[240, 400]} sizes="40vw" loading="lazy" />
              </span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="idx-foot" data-reveal="fade">
      <a class="btn btn--ghost" href={url('/koleksiyon/')}>Tüm koleksiyon <span class="arrow" aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="idx-preview" aria-hidden="true" data-idx-preview>
    {
      products.map((p, i) => (
        <div class="idx-pv" data-pv={i}>
          <Image src={img(heroImg[p.slug] ?? coverImage(p))} alt="" widths={[480, 720]} sizes="28vw" loading="lazy" />
        </div>
      ))
    }
  </div>
</section>

<style is:global>
  .idx {
    position: relative;
    padding: clamp(100px, 14vw, 200px) 0 clamp(80px, 10vw, 140px);
  }
  .idx-head {
    display: grid;
    grid-template-columns: 1fr minmax(0, 30ch);
    grid-template-areas: 'label label' 'title intro';
    align-items: end;
    gap: 22px 40px;
    margin-bottom: clamp(40px, 6vw, 80px);
  }
  .idx-head .label {
    grid-area: label;
  }
  .idx-head h2 {
    grid-area: title;
  }
  .idx-intro {
    grid-area: intro;
    color: var(--mute);
  }
  .idx-list {
    border-top: 1px solid var(--line);
  }
  .idx-row {
    position: relative;
    display: grid;
    grid-template-columns: 4em minmax(0, 1fr) minmax(0, 15em) 4em 13em;
    align-items: center;
    gap: 20px;
    padding: clamp(10px, 1.6vw, 22px) 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    isolation: isolate;
  }
  .idx-row::before {
    /* hover'da satırın altından yükselen yeşil deri şeridi */
    content: '';
    position: absolute;
    inset: 0 calc(var(--gutter) * -1);
    background: var(--forest);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.6s var(--ease-cut);
    z-index: -1;
  }
  .idx-no {
    color: var(--thread-light);
  }
  .idx-name {
    font-size: clamp(2.6rem, 6.6vw, 7rem);
    line-height: 0.95;
    padding-top: 0.04em;
    transition:
      font-stretch 0.8s var(--ease-settle),
      color 0.4s;
    white-space: nowrap;
  }
  .idx-kind {
    color: var(--mute);
  }
  .idx-price {
    text-align: right;
  }
  .idx-thumb {
    display: none;
  }
  @media (hover: hover) and (min-width: 1024px) {
    .idx-row:hover::before,
    .idx-row:focus-visible::before {
      transform: scaleY(1);
    }
    .idx-row:hover .idx-name,
    .idx-row:focus-visible .idx-name {
      font-stretch: 125%;
    }
  }
  .idx-foot {
    margin-top: 40px;
  }

  /* İmleci izleyen önizleme */
  .idx-preview {
    position: fixed;
    left: 0;
    top: 0;
    width: clamp(220px, 22vw, 360px);
    aspect-ratio: 4 / 5;
    pointer-events: none;
    z-index: 30;
    border-radius: 18px;
    overflow: hidden;
    clip-path: inset(50% 50% 50% 50% round 18px);
    background: #000;
    visibility: hidden;
  }
  .idx-pv {
    position: absolute;
    inset: 0;
    opacity: 0;
  }
  .idx-pv.is-on {
    opacity: 1;
  }
  .idx-pv img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 1023px), (hover: none) {
    .idx-preview {
      display: none;
    }
    .idx-head {
      grid-template-columns: 1fr;
      grid-template-areas: 'label' 'title' 'intro';
    }
    .idx-row {
      grid-template-columns: 2.4em minmax(0, 1fr) auto;
      grid-template-areas:
        'no name thumb'
        '. kind thumb'
        '. meta thumb';
      gap: 4px 14px;
      padding: 18px 0;
    }
    .idx-no {
      grid-area: no;
      align-self: start;
      padding-top: 0.6em;
    }
    .idx-name {
      grid-area: name;
      font-size: clamp(2.4rem, 11vw, 4.6rem);
    }
    .idx-kind {
      grid-area: kind;
    }
    .idx-sw {
      grid-area: meta;
    }
    .idx-price {
      grid-area: meta;
      text-align: left;
      padding-left: 46px;
    }
    .idx-thumb {
      grid-area: thumb;
      display: block;
      width: clamp(84px, 26vw, 150px);
      aspect-ratio: 1;
      border-radius: 14px;
      overflow: hidden;
      transform: scale(0.82);
      opacity: 0.55;
      transition:
        transform 0.7s var(--ease-settle),
        opacity 0.5s;
    }
    .idx-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .idx-item.is-active .idx-thumb {
      transform: none;
      opacity: 1;
    }
    .idx-item.is-active .idx-name {
      font-stretch: 100%;
      color: var(--chalk);
    }
    .idx-item:not(.is-active) .idx-name {
      color: rgb(232 233 226 / 0.55);
    }
  }
</style>
