---
import { url } from '../lib/url';
import { STORE } from '../data/products';
---

<dialog class="cart" aria-labelledby="cart-title" data-cart transition:persist="cart" data-store={STORE}>
  <div class="cart-inner">
    <div class="cart-head">
      <h2 id="cart-title" class="display d-s">Sepet</h2>
      <button class="hdr-btn" type="button" data-cart-close>
        <span>Kapat</span><span class="x" aria-hidden="true"></span>
      </button>
    </div>

    <div class="ship" data-ship>
      <p class="mono" data-ship-text>3.000 TL ve üzeri siparişlerde kargo ücretsiz.</p>
      <div class="ship-bar" aria-hidden="true"><span data-ship-bar></span></div>
    </div>

    <ul class="cart-items" role="list" data-cart-items aria-live="polite"></ul>

    <div class="cart-empty" data-cart-empty>
      <p class="display d-m">Henüz boş.</p>
      <p class="mono">Bir cüzdan, bir matara ya da hazır bir hediye seti ile başlayın.</p>
      <a class="btn" href={url('/koleksiyon/')}>Koleksiyona git <span class="arrow" aria-hidden="true">→</span></a>
    </div>

    <div class="cart-foot" data-cart-foot>
      <div class="cart-total">
        <span class="label">Ara toplam</span>
        <span class="price" data-cart-total>0 TL</span>
      </div>
      <a class="btn btn--thread cart-checkout" href="#" data-cart-checkout>
        Güvenli ödemeye geç <span class="arrow" aria-hidden="true">→</span>
      </a>
      <p class="mono cart-note">
        Ödeme, Bizon Leather'ın mevcut Shopify mağazasındaki güvenli ödeme sayfasında tamamlanır. Kargo ücreti ödeme adımında hesaplanır.
      </p>
    </div>
  </div>
</dialog>

<style is:global>
  .cart {
    position: fixed;
    inset: 0 0 0 auto;
    width: min(460px, 100vw);
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--chalk);
    color: var(--ink);
    color-scheme: light;
  }
  .cart::backdrop {
    background: rgb(6 8 7 / 0.6);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
  }
  .cart-inner {
    height: 100%;
    display: flex;
    flex-direction: column;
    padding: 0 24px 24px;
    overflow-y: auto;
  }
  .cart-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    flex: none;
  }
  .cart .hdr-btn {
    background: rgb(6 8 7 / 0.07);
    color: var(--ink);
  }
  .ship {
    padding: 14px 0 18px;
    border-bottom: 1px solid var(--line-ink);
  }
  .ship p {
    margin-bottom: 10px;
  }
  .ship-bar {
    height: 2px;
    background-image: linear-gradient(90deg, rgb(6 8 7 / 0.18) 0 60%, transparent 60%);
    background-size: 10px 2px;
    position: relative;
  }
  .ship-bar span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0%;
    background-image: linear-gradient(90deg, var(--thread-ink) 0 60%, transparent 60%);
    background-size: 10px 2px;
    transition: width 0.8s var(--ease-settle);
  }
  .cart-items {
    flex: 1;
  }
  .cart-item {
    display: grid;
    grid-template-columns: 76px 1fr auto;
    gap: 14px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--line-ink);
  }
  .cart-item img {
    width: 76px;
    height: 76px;
    object-fit: cover;
    border-radius: 10px;
    background: #000;
  }
  .ci-name {
    font-weight: 700;
    font-stretch: 90%;
    line-height: 1.2;
  }
  .ci-meta {
    color: var(--mute-ink);
  }
  .qty {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-top: 8px;
    border-radius: 999px;
    box-shadow: inset 0 0 0 1px var(--line-ink);
  }
  .qty button {
    width: 32px;
    height: 32px;
    border: 0;
    background: none;
    border-radius: 50%;
    font-family: var(--f-mono);
  }
  .qty button:hover {
    background: rgb(6 8 7 / 0.07);
  }
  .qty output {
    min-width: 1.6em;
    text-align: center;
    font-family: var(--f-mono);
    font-size: 0.85rem;
  }
  .ci-remove {
    border: 0;
    background: none;
    font-family: var(--f-mono);
    font-size: 0.72rem;
    text-decoration: underline;
    color: var(--mute-ink);
    padding: 6px 0;
    margin-top: 4px;
  }
  .cart-empty {
    flex: 1;
    display: grid;
    align-content: center;
    gap: 16px;
    justify-items: start;
    padding: 40px 0;
  }
  .cart-empty[hidden],
  .cart-foot[hidden] {
    display: none;
  }
  .cart-foot {
    display: grid;
    gap: 14px;
    padding-top: 18px;
  }
  .cart-total {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }
  .cart-total .price {
    font-size: 1.2rem;
  }
  .cart-checkout {
    justify-content: center;
  }
  .cart-note {
    color: var(--mute-ink);
    font-size: 0.7rem;
  }
</style>
