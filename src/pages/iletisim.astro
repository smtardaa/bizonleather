---
import Layout from '../layouts/Layout.astro';
import Bison from '../components/Bison.astro';
import { SITE } from '../data/site';
const topics = [
  { v: 'siparis', l: 'Sipariş' },
  { v: 'kisisellestirme', l: 'Kişiselleştirme' },
  { v: 'kurumsal', l: 'Kurumsal / toptan' },
  { v: 'kargo', l: 'Kargo' },
  { v: 'iade', l: 'İade ve değişim' },
  { v: 'basin', l: 'Basın / satış noktası' },
  { v: 'diger', l: 'Diğer' },
];
---

<Layout title="İletişim" description="Bizon Leather ile iletişim: leatherbizon@gmail.com, Instagram @bizongoods. Mesajlara 1–2 iş günü içinde dönüş yapılır." page="contact">
  <section class="ct wrap" data-contact aria-labelledby="ct-title">
    <div class="ct-left">
      <p class="label">İletişim · {SITE.hours}</p>
      <h1 id="ct-title" class="display d-xxl" data-reveal="lines">
        <span class="ln"><span>Yazın.</span></span>
      </h1>
      <p class="ct-lead" data-reveal="fade">
        Sipariş, kargo, iade, kişiselleştirme, kurumsal hediye, basın ve satış noktası talepleri için. Siparişinizle ilgili yazıyorsanız sipariş
        numaranızı ekleyin. Mesajlara 1–2 iş günü içinde dönüş yapılır.
      </p>
      <ul class="ct-channels" role="list" data-reveal="stagger">
        <li>
          <span class="mono">E-posta</span>
          <a class="link-u" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <button type="button" class="mono ct-copy" data-copy={SITE.email}>Kopyala</button>
        </li>
        <li>
          <span class="mono">Instagram</span>
          <a class="link-u" href={SITE.instagramUrl} target="_blank" rel="noopener">@{SITE.instagram} ↗</a>
        </li>
        <li>
          <span class="mono">Atölye</span>
          <span>{SITE.city} · {SITE.hours}</span>
        </li>
      </ul>
      <Bison class="ct-mark" />
    </div>

    <form class="ct-form" data-ct-form novalidate>
      <div class="f-row">
        <div class="f">
          <label for="f-name">Ad Soyad</label>
          <input id="f-name" name="name" autocomplete="name" required />
          <span class="f-err mono" aria-live="polite"></span>
        </div>
        <div class="f">
          <label for="f-mail">E-posta</label>
          <input id="f-mail" name="email" type="email" autocomplete="email" required />
          <span class="f-err mono" aria-live="polite"></span>
        </div>
      </div>
      <div class="f-row">
        <div class="f">
          <label for="f-phone">Telefon <em>(isteğe bağlı)</em></label>
          <input id="f-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" />
        </div>
        <div class="f">
          <label for="f-order">Sipariş no <em>(varsa)</em></label>
          <input id="f-order" name="order" />
        </div>
      </div>
      <fieldset class="f f-topics">
        <legend>Konu</legend>
        <div class="topics">
          {
            topics.map((t, i) => (
              <label class="chip">
                <input type="radio" name="topic" value={t.v} checked={i === 0} />
                <span>{t.l}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <div class="f">
        <label for="f-msg">Mesaj</label>
        <textarea id="f-msg" name="message" rows="6" required></textarea>
        <span class="f-err mono" aria-live="polite"></span>
      </div>
      <div class="ct-submit">
        <button type="submit" class="btn btn--thread">E-postayı hazırla <span class="arrow" aria-hidden="true">→</span></button>
        <p class="mono ct-note">
          Bu form, mesajınızı e-posta uygulamanızda {SITE.email} adresine hazırlar; gönder tuşuna siz basarsınız. Bilgileriniz bu sitede saklanmaz.
        </p>
      </div>
      <div class="ct-done" data-ct-done hidden role="status">
        <p class="display d-s">E-posta uygulamanız açıldı.</p>
        <p class="mono">Açılmadıysa mesajınızı kopyalayıp {SITE.email} adresine gönderebilirsiniz.</p>
        <button type="button" class="btn btn--ghost" data-ct-copymsg>Mesajı kopyala</button>
      </div>
    </form>
  </section>
</Layout>

<style>
  .ct {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 40px clamp(40px, 6vw, 110px);
    padding-top: calc(var(--header-h) + clamp(40px, 7vw, 90px));
    padding-bottom: clamp(90px, 12vw, 160px);
  }
  .ct-left {
    display: grid;
    gap: 26px;
    align-content: start;
  }
  .ct-left h1 {
    margin-left: -0.04em;
  }
  .ct-lead {
    color: var(--mute);
    max-width: 44ch;
  }
  .ct-channels {
    display: grid;
  }
  .ct-channels li {
    display: grid;
    grid-template-columns: 7em 1fr auto;
    align-items: baseline;
    gap: 12px;
    padding: 16px 0;
    border-top: 1px solid var(--line);
    font-size: 1.15rem;
  }
  .ct-channels .mono {
    color: var(--thread-light);
  }
  .ct-channels a {
    text-decoration: none;
  }
  .ct-copy {
    border: 0;
    background: rgb(232 233 226 / 0.08);
    border-radius: 999px;
    padding: 6px 12px;
    color: var(--chalk) !important;
  }
  :global(.ct-mark) {
    width: 90px;
    color: var(--forest);
    margin-top: 20px;
  }

  .ct-form {
    display: grid;
    gap: 20px;
    align-content: start;
    padding: clamp(22px, 3vw, 40px);
    border-radius: 28px;
    background: var(--chalk);
    color: var(--ink);
    color-scheme: light;
    position: relative;
  }
  .ct-form::before {
    content: '';
    position: absolute;
    inset: 10px;
    border-radius: 20px;
    border: 2px dashed rgb(42 69 216 / 0.5);
    pointer-events: none;
  }
  .f-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .f {
    display: grid;
    gap: 8px;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .f label,
  .f legend {
    font-family: var(--f-mono);
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mute-ink);
    padding: 0;
  }
  .f legend {
    margin-bottom: 8px;
  }
  .f em {
    font-style: normal;
    text-transform: none;
    opacity: 0.8;
  }
  .f input,
  .f textarea {
    width: 100%;
    padding: 14px 16px;
    border-radius: 14px;
    border: 1.5px solid var(--line-ink);
    background: #fff;
    color: var(--ink);
    font-size: 1rem;
    transition: border-color 0.3s;
  }
  .f textarea {
    resize: vertical;
    min-height: 140px;
  }
  .f input:focus,
  .f textarea:focus {
    outline: none;
    border-color: var(--thread-ink);
    box-shadow: 0 0 0 3px rgb(42 69 216 / 0.15);
  }
  .f [aria-invalid='true'] {
    border-color: #c2410c;
  }
  .f-err {
    color: #b42318;
    font-size: 0.72rem;
    min-height: 1em;
  }
  .topics {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ct-form .chip span {
    box-shadow: inset 0 0 0 1.5px var(--line-ink);
    height: 40px;
  }
  .ct-form .chip input:checked + span {
    background: var(--ink);
    color: var(--chalk);
    box-shadow: none;
  }
  .ct-submit {
    display: grid;
    gap: 12px;
    justify-items: start;
  }
  .ct-note {
    color: var(--mute-ink);
    font-size: 0.7rem;
    max-width: 60ch;
  }
  .ct-done {
    display: grid;
    gap: 10px;
    justify-items: start;
    padding: 20px;
    border-radius: 16px;
    background: rgb(42 69 216 / 0.08);
  }
  .ct-done[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .ct,
    .f-row {
      grid-template-columns: 1fr;
    }
    .ct-channels li {
      grid-template-columns: 1fr auto;
    }
    .ct-channels li > .mono:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
